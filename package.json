{
  "name": "vocab-vault",
  "version": "0.1.0",
  "private": true,
  "description": "VocabVault — Smart Vocabulary Flashcard Web Platform",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "install-all": "npm install --workspaces --include-workspace-root",
    "dev": "concurrently -n api,web -c blue,green \"npm run dev -w server\" \"npm run dev -w client\"",
    "dev:server": "npm run dev -w server",
    "dev:client": "npm run dev -w client",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:study": "playwright test --project=chromium e2e/study-flows.spec.js",
    "test:e2e:design": "playwright test --project=chromium --project=mobile e2e/design-contract.spec.js",
    "test:e2e:auth": "playwright test --project=chromium e2e/auth-lifecycle.spec.js",
    "seed": "npm run seed -w server",
    "audio:generate": "python3 scripts/generate-audio.py",
    "prepare": "husky || true"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@playwright/test": "^1.63.0",
    "concurrently": "^9.1.2",
    "husky": "^9.1.7",
    "vitest": "^4.1.11"
  }
}
