{
  "name": "vocab-vault",
  "version": "0.1.0",
  "private": true,
  "description": "VocabVault — Smart Vocabulary Flashcard Web Platform",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "install-all": "npm install --workspaces --include-workspace-root",
    "dev": "concurrently -n api,web -c blue,green \"npm run dev -w server\" \"npm run dev -w client\"",
    "dev:server": "npm run dev -w server",
    "dev:client": "npm run dev -w client",
    "seed": "npm run seed -w server",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "concurrently": "^9.1.2",
    "husky": "^9.1.7"
  }
}
