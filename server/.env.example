# Server environment — copy to .env and fill in
PORT=5000
JWT_SECRET=change-me-to-a-long-random-string
# MongoDB Atlas connection string (free M0 cluster)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/flashcards?retryWrites=true&w=majority
# Production only: primary web origin for CORS and password-reset links. Leave unset locally.
CLIENT_URL=https://vvault.pages.dev
# Production only: extra comma-separated web origins allowed for password-reset links.
ALLOWED_ORIGINS=
# Dev only (default false): print reset links to the API console and return devResetUrl
# from POST /api/auth/forgot-password. Never enable in production.
DEV_RESET_LINK=false
